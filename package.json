{
  "name": "cue-tools",
  "displayName": "cue-tools",
  "description": "Tools for creating and editing CUE sheets",
  "version": "0.4.1",
  "repository": "github:chrisrode/cue-tools",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cue-tools.importTracklist",
        "title": "Cue Tools: Import Tracklist from 1001Tracklists.com"
      }
    ],
    "configuration": {
      "title": "Cue Tools",
      "properties": {
        "cue-tools.appendLosslessCutEndMarker": {
          "type": "boolean",
          "default": false,
          "description": "Append a titleless terminal CUE track at the detected media duration so LosslessCut treats the final real track as a segment. Requires structured JSON containing mediaDurationSeconds."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rimraf out",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
